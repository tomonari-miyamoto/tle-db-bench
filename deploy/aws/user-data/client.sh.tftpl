#!/bin/bash
# Client host bootstrap (Ubuntu 24.04). Rendered by Terraform templatefile().
set -euo pipefail
exec > >(tee -a /var/log/tlebench-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive

echo "${bucket}" > /etc/tlebench-bucket

# On Nitro the attached volume appears as NVMe with the volume id (no dash) as serial.
VOLUME_SERIAL=$(echo "${volume_id}" | tr -d '-')

find_device() {
  local dev=""
  for _ in $(seq 1 60); do
    dev=$(lsblk -dno NAME,SERIAL | awk -v s="$VOLUME_SERIAL" '$2 == s {print "/dev/" $1}' | head -n1)
    if [ -z "$dev" ]; then
      # Fallback: first non-root disk without a filesystem or mountpoint.
      dev=$(lsblk -dno NAME,TYPE | awk '$2 == "disk" {print "/dev/" $1}' | while read -r d; do
        if [ -z "$(lsblk -no MOUNTPOINT,FSTYPE "$d" | tr -d '[:space:]')" ]; then
          echo "$d"
          break
        fi
      done)
    fi
    if [ -n "$dev" ]; then
      echo "$dev"
      return 0
    fi
    sleep 5
  done
  return 1
}

DEV=$(find_device || true)
if [ -z "$DEV" ]; then
  echo "data device not found" >&2
  exit 1
fi

if ! blkid "$DEV" > /dev/null 2>&1; then
  mkfs.ext4 -L tlebench-data "$DEV"
fi
mkdir -p /data
UUID=$(blkid -s UUID -o value "$DEV")
if ! grep -q "$UUID" /etc/fstab; then
  echo "UUID=$UUID /data ext4 defaults,nofail 0 2" >> /etc/fstab
fi
mountpoint -q /data || mount /data

apt-get update
apt-get install -y git unzip python3 iperf3 curl jq

# AWS CLI v2 (official zip installer)
tmp=$(mktemp -d)
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "$tmp/awscliv2.zip"
unzip -q "$tmp/awscliv2.zip" -d "$tmp"
"$tmp/aws/install" --update
rm -rf "$tmp"

# uv for the ubuntu user
sudo -u ubuntu -H bash -c 'curl -LsSf https://astral.sh/uv/install.sh | sh'

mkdir -p /data/tlebench
chown ubuntu:ubuntu /data/tlebench
echo "bootstrap done"
