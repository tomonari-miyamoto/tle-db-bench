# Copy to .env and change the passwords. Benchmark-only credentials; never reuse real ones.

# Identical resource limits applied to BOTH database containers.
CPU_LIMIT=4
MEM_LIMIT=8g
# timescaledb-tune hints; keep in line with the limits above.
TS_TUNE_MEMORY=8GB
TS_TUNE_NUM_CPUS=4

# ClickHouse
CH_HOST=127.0.0.1
CH_HTTP_PORT=8123
CH_USER=bench
CH_PASSWORD=change-me-clickhouse
CH_DATABASE=bench
# clickhouse-connect wire compression: false | lz4 | zstd
CH_COMPRESS=false

# TimescaleDB
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=bench
PG_PASSWORD=change-me-timescale
PG_DATABASE=bench

# Compose only: address the DB ports bind to (default 127.0.0.1). 0.0.0.0 is for a dedicated
# benchmark host whose firewall/security group restricts the ports.
# BIND_ADDR=127.0.0.1

# Client only: replaces `docker compose restart` for --cold. "{service}" becomes the service name.
# Runs through the shell on the client machine; meant for a remote restart plus OS page-cache drop.
# The string is recorded in results metadata, so keep secrets in the script, not in the command.
# Relative paths resolve against the directory tlebench is run from (normally the repo root).
# COLD_RESTART_CMD=deploy/aws/scripts/cold-restart.sh {service}

# Read timeout (s) for the ClickHouse load client; OPTIMIZE FINAL at 100M rows takes long.
CH_LOAD_TIMEOUT_S=21600
